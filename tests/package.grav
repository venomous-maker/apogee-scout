// ScoutPackage: the index table from its migration, and the database engine.
import "std"
import "apogee-container"
import "apogee-package"
import "grav-db"
import "grav-orbit"
import "../src/all.grav"
use apogee.*
use db.*
use orbit.*

test "the package connects itself" {
    let file = Dir.temp() + "/scout_pkg_" + str(Process.pid()) + ".sqlite"
    new File(file).delete()
    DB.connect(Sqlite.open(file))
    let ps = Packages.discover()
    assertEq(ps[0].name(), "scout")
    Packages.applyDefaults(ps)
    assertEq(ps[0].migrations().size(), 1)
    for (m in ps[0].migrations()) { (m as Migration).up() }
    assert(Schema.hasTable("scout_index"))
    let ctx = new PackageContext(new Container(), "testing", "")
    ctx.poolFn = fn() -> Pool { return new Pool(1, fn() -> Connection { return Sqlite.open(file) as Connection }) }
    ps[0].boot(ctx)
    assert(Scout.engine is DatabaseEngine)
    new File(file).delete()
}

// With SCOUT_MYSQL_URL / SCOUT_POSTGRES_URL set (mysql://… / postgres://…).
test "the migration on MySQL and PostgreSQL" {
    for (url in [env("SCOUT_MYSQL_URL"), env("SCOUT_POSTGRES_URL")]) {
        if (url == "") { continue }
        DB.connect(Str.startsWith(url, "mysql") ? MySql.open(url) as Connection : Postgres.open(url) as Connection)
        for (m in Packages.discover()[0].migrations()) { (m as Migration).down() }
        for (m in Packages.discover()[0].migrations()) { (m as Migration).up() }
        assert(Schema.hasTable("scout_index"))
        for (m in Packages.discover()[0].migrations()) { (m as Migration).down() }
        assert(!Schema.hasTable("scout_index"))
    }
}
