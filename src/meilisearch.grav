// meilisearch.grav — indexes in a Meilisearch server (typo tolerance,
// ranking rules and speed for large sites), over its HTTP API.
//
//   Scout.use(new MeilisearchEngine("http://127.0.0.1:7700", env("MEILI_KEY")))
import "std"
import "apogee-http-client"
import "engines.grav"

namespace apogee {

    class MeilisearchEngine implements SearchEngine {
        public host: string
        private key: string
        // Wait for each write to be applied before returning (tests, scripts).
        public wait: bool
        private filterable: HashMap<string, HashSet<string>> = new HashMap<string, HashSet<string>>()
        private lock: Mutex = new Mutex()

        constructor(host: string, key: string = "", wait: bool = false) {
            self.host = Str.endsWith(host, "/") ? host[..host.length - 1] : host;
            self.key = key;
            self.wait = wait;
        }
        private fn req() -> PendingRequest {
            let r = Fetch.request().acceptJson().timeoutMs(30000);
            if (self.key != "") { r.withToken(self.key); }
            return r;
        }
        private fn uid(index: string) -> string {
            return Url.encode(index);
        }
        // Waits for an asynchronous task (the response of a write) to finish.
        // (`missingIsFine`: an index that is not there is nothing to undo)
        private fn settle(res: ClientResponse, missingIsFine: bool = false) {
            res.throwIfFailed();
            if (!self.wait) { return; }
            let task = res.jsonAt("taskUid");
            if (task == null) { return; }
            let until = Time.monotonicMs() + 30000;
            while (Time.monotonicMs() < until) {
                let t = self.req().get(self.host + "/tasks/" + task.toJson()).throwIfFailed();
                let status = t.jsonAt("status").asString();
                if (status == "succeeded") { return; }
                if (status == "failed" || status == "canceled") {
                    let code = t.jsonAt("error.code");
                    if (missingIsFine && code != null && code.asString() == "index_not_found") { return; }
                    let e = t.jsonAt("error.message");
                    throw new StateError("Meilisearch task failed: " + (e == null ? status : e.asString()));
                }
                Time.sleepMs(20);
            }
            throw new StateError("Meilisearch task ${task.toJson()} did not finish in 30 s");
        }
        fn update(index: string, docs: Array<SearchDocument>) {
            if (docs.isEmpty()) { return; }
            let arr = Json.array();
            for (d in docs) {
                let o = Json.parse(d.fieldsJson());
                o.set("id", d.id);
                arr.push(o);
            }
            self.settle(self.req().withBody(arr.toJson(), "application/json")
                            .post(self.host + "/indexes/" + self.uid(index) + "/documents?primaryKey=id"));
        }
        fn delete(index: string, ids: Array<string>) {
            if (ids.isEmpty()) { return; }
            let arr = Json.array();
            for (i in ids) { arr.push(i); }
            self.settle(self.req().withBody(arr.toJson(), "application/json")
                            .post(self.host + "/indexes/" + self.uid(index) + "/documents/delete-batch"), true);
        }
        fn flush(index: string) {
            let res = self.req().delete(self.host + "/indexes/" + self.uid(index) + "/documents");
            if (res.status == 404) { return; }
            self.settle(res, true);
        }
        // Filters need their fields marked filterable (done once per field).
        private fn ensureFilterable(index: string, fields: Array<string>) {
            self.lock.lock();
            let known = self.filterable.getOr(index, null);
            if (known == null) {
                known = new HashSet<string>()
                self.filterable.put(index, known)
            }
            let missing = fields.filter(fn(f: string) => !known.contains(f));
            self.lock.unlock();
            if (missing.isEmpty()) { return; }
            let current = self.req().get(self.host + "/indexes/" + self.uid(index) + "/settings/filterable-attributes");
            let all = new HashSet<string>();
            if (current.ok() && current.json().isArray()) { for (v in current.json().asArray()) { all.add(v.asString()); } }
            for (f in fields) { all.add(f); }
            let arr = Json.array();
            for (f in all.toArray()) { arr.push(f); }
            let was = self.wait;
            self.wait = true;                        // (the search right after needs it applied)
            try {
                self.settle(self.req().withBody(arr.toJson(), "application/json")
                                .put(self.host + "/indexes/" + self.uid(index) + "/settings/filterable-attributes"));
            } finally { self.wait = was; }
            self.lock.lock();
            for (f in fields) { known.add(f); }
            self.lock.unlock();
        }
        fn search(index: string, q: SearchQuery) -> SearchResult {
            let res = new SearchResult();
            let body = Json.object();
            body.set("q", q.text);
            body.set("limit", q.limit as long);
            body.set("offset", q.offset as long);
            body.set("matchingStrategy", "all");            // every word, as the other engines do
            let attrs = Json.array();
            attrs.push("id");
            body.set("attributesToRetrieve", attrs);
            if (!q.filters.isEmpty()) {
                self.ensureFilterable(index, q.filters.keys());
                let all = Json.array();
                for ((f, values) in q.filters) {
                    let any = Json.array();
                    for (v in values) { any.push(f + " = " + Json.of(v).toJson()); }
                    all.push(any);
                }
                body.set("filter", all);
            }
            let r = self.req().withBody(body.toJson(), "application/json").post(self.host + "/indexes/" + self.uid(index) + "/search");
            if (r.status == 404) { return res; }                         // (no such index yet)
            r.throwIfFailed();
            for (hit in r.jsonAt("hits").asArray()) {
                let id = hit.get("id");
                res.ids.push(id.isString() ? id.asString() : id.toJson());
            }
            let total = r.jsonAt("estimatedTotalHits");
            res.total = total == null ? res.ids.size() as long : total.asLong();
            return res;
        }
    }
}
